# MySQL connection. Same database the PHP site used, or a new one.
DATABASE_URL=mysql://root:@127.0.0.1:3306/shreemohansweets

# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Admin login. Generate the hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Where admin product uploads are stored. Must survive redeploys.
UPLOAD_DIR=./storage/uploads

NEXT_PUBLIC_SITE_URL=https://example.com
